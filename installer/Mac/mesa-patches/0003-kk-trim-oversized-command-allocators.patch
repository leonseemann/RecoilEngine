kk: replace command allocators that grew far beyond their recent use

An MTL4CommandAllocator keeps the memory of the largest batch it encoded,
and KosmicKrisp 26.2 begins a Metal command buffer per render pass from it
(about 2-4 MB each). Loading screens record batches with a thousand
passes, so BAR ended up with allocators of up to 2 GB that were never
needed again: a 30 GB process footprint after loading a game, growing
with every further game, as the GL context lives on between lobby and
games.

Every 64 resets, replace an allocator that is more than twice as large
as the most command buffers it served in that window need.

--- a/src/kosmickrisp/bridge/mtl_command_buffer.h
+++ b/src/kosmickrisp/bridge/mtl_command_buffer.h
@@ -12,6 +12,8 @@
 #include <stdint.h>
 
 void mtl_command_allocator_reset(mtl_command_allocator *allocator);
+uint64_t
+mtl_command_allocator_get_allocated_size(mtl_command_allocator *allocator);
 
 void mtl_begin_command_buffer(mtl_command_buffer *command_buffer,
                               mtl_command_allocator *allocator);
--- a/src/kosmickrisp/bridge/mtl_command_buffer.m
+++ b/src/kosmickrisp/bridge/mtl_command_buffer.m
@@ -20,6 +20,15 @@
    }
 }
 
+uint64_t
+mtl_command_allocator_get_allocated_size(mtl_command_allocator *allocator)
+{
+   @autoreleasepool {
+      id<MTL4CommandAllocator> alloc = (id<MTL4CommandAllocator>)allocator;
+      return [alloc allocatedSize];
