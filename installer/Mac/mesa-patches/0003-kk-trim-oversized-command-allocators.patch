--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -168,9 +168,39 @@
    return result;
 }
 
+/* An MTL4CommandAllocator keeps the memory of the largest batch it encoded,
+ * and every render pass begins its own command buffer from it. Batches with
+ * a thousand passes, as recorded while loading, leave allocators of several
+ * GB behind that are never needed again. Replace allocators that stayed far
+ * larger than what the last uses needed. */
+#define KK_ALLOCATOR_TRIM_WINDOW       64u
+#define KK_ALLOCATOR_BYTES_PER_CMD_BUF (4ull * 1024 * 1024)
+#define KK_ALLOCATOR_MIN_BYTES         (64ull * 1024 * 1024)
+
 static void
-kk_reset_encoder_state(struct kk_encoder_state *es)
+kk_reset_encoder_state(struct kk_encoder_state *es, mtl_device *handle)
 {
+   es->window_max_cmd_bufs = MAX2(es->window_max_cmd_bufs, es->cmd_buf_count);
+   es->cmd_buf_count = 0u;
+
+   if (++es->window_resets >= KK_ALLOCATOR_TRIM_WINDOW) {
+      uint64_t needed_B =
+         MAX2(es->window_max_cmd_bufs * KK_ALLOCATOR_BYTES_PER_CMD_BUF,
+              KK_ALLOCATOR_MIN_BYTES);
+      es->window_resets = 0u;
+      es->window_max_cmd_bufs = 0u;
+
+      if (mtl_command_allocator_get_allocated_size(es->allocator) >
+          2u * needed_B) {
+         mtl_command_allocator *allocator = mtl_new_command_allocator(handle);
+         if (allocator) {
+            mtl_release(es->allocator);
+            es->allocator = allocator;
+            return;
+         }
+      }
+   }
+
    mtl_command_allocator_reset(es->allocator);
 }
 
